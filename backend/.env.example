# Copy this file to ".env" (same folder) and fill in your keys.
# NEVER commit .env to GitHub.

# --- Claude API (https://platform.claude.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Stop calling Claude after this much spend per month (USD) -> random fallback
CLAUDE_MONTHLY_BUDGET_USD=3
# Prices used to estimate spend (USD per 1M tokens). Update if Anthropic changes them.
CLAUDE_INPUT_PRICE_PER_MTOK=0.10
CLAUDE_OUTPUT_PRICE_PER_MTOK=0.50

# --- Google Places API (New) ---
GOOGLE_MAPS_API_KEY=
# Text Search Enterprise has 1,000 free calls/month; stop a bit before that
PLACES_MONTHLY_LIMIT=900
# Search radius around the user (metres)
PLACES_RADIUS_M=2000

# --- Protection ---
# Max requests per minute per visitor, for each API
RATE_LIMIT_PER_MINUTE=10
